# Copia este archivo como .env y ajusta los valores.

# Orígenes del frontend que pueden llamar a la API (separados por comas).
# En local, Angular corre en el puerto 4200.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Servidor del modelo, compatible con OpenAI. En local: LM Studio con el servidor encendido.
LLM_BASE_URL=http://127.0.0.1:1234/v1
# Nombre del modelo tal como aparece en LM Studio (pestaña Developer -> identificador del modelo).
LLM_MODEL=vertex-math-vision-v2
LLM_API_KEY=
LLM_TIMEOUT_S=120
LLM_MAX_TOKENS=900
LLM_TEMPERATURE=0.2

# Portero (V-SRT) opcional. Vacío = solo validación local.
PORTERO_URL=

# Reportes de error del tutor: solo texto, nunca fotos.
REPORT_LOG_PATH=data/reports.jsonl

# Límites
TEXT_MAX_CHARS=1000
IMAGE_MAX_MB=8
IMAGE_MAX_SIDE=1280
RATE_LIMIT_PER_MIN=10
