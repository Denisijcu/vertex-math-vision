# Hugging Face Credentials (Read/Write for Model Hub)
HF_TOKEN="hf_your_secure_token_here"

# Hardware & Model Target Configuration
BASE_MODEL="unsloth/Qwen2.5-VL-7B-Instruct-bnb-4bit"
# Para pruebas en GTX 1660 Ti (6GB VRAM), cambiar a:
# BASE_MODEL="unsloth/Qwen2.5-VL-3B-Instruct-bnb-4bit"

MAX_IMAGE_PIXELS=1000000
LORA_RANK=16
LORA_ALPHA=16
BATCH_SIZE=2
GRAD_ACCUMULATION=4
LEARNING_RATE=2e-4
EPOCHS=3